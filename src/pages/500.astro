---
import Layout from '../layouts/Layout.astro';
---
<Layout title="500 — Server Error | MathsIsCool" description="Something went wrong. Go back to MathsIsCool for free math tables and formulas.">
<div class="page">
  <section style="text-align:center;padding:60px 20px;max-width:500px;margin:0 auto;">
    <div style="font-size:4rem;margin-bottom:16px;">⚠️</div>
    <h1 style="font-family:'Nunito',sans-serif;font-size:3rem;font-weight:900;color:var(--color-diff);margin-bottom:12px;">500</h1>
    <h2 style="font-size:1.3rem;margin-bottom:14px;font-family:'Nunito',sans-serif;">Something went wrong!</h2>
    <p style="color:var(--text-2);margin-bottom:28px;">Professor Hoot is on it! Try refreshing or go back to the homepage.</p>
    <a href="/" style="background:var(--owl-brown);color:white;padding:14px 32px;border-radius:100px;font-family:'Nunito',sans-serif;font-weight:800;font-size:1rem;text-decoration:none;display:inline-block;">← Back to MathsIsCool</a>
  </section>
</div>
</Layout>
