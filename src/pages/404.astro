---
import Layout from '../layouts/Layout.astro';
---
<Layout title="404 — Page Not Found | MathsIsCool" description="Page not found. Go back to MathsIsCool for free math tables and formulas.">
<div class="page">
  <section style="text-align:center;padding:60px 20px;max-width:500px;margin:0 auto;">
    <img src="/images/owl-reactions.png" alt="Confused owl" style="width:140px;height:140px;object-fit:contain;margin:0 auto 20px;display:block;" />
    <h1 style="font-family:'Nunito',sans-serif;font-size:3rem;font-weight:900;color:var(--owl-brown);margin-bottom:12px;">404</h1>
    <h2 style="font-size:1.3rem;margin-bottom:14px;font-family:'Nunito',sans-serif;">Hoot! Page Not Found</h2>
    <p style="color:var(--text-2);margin-bottom:28px;">Professor Hoot searched everywhere but couldn't find this page. Try going back to the homepage!</p>
    <a href="/" style="background:var(--owl-brown);color:white;padding:14px 32px;border-radius:100px;font-family:'Nunito',sans-serif;font-weight:800;font-size:1rem;text-decoration:none;display:inline-block;">← Back to MathsIsCool</a>
  </section>
</div>
</Layout>
