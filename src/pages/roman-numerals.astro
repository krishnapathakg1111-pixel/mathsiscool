          <th>#</th><th>Roman</th>
        </tr>
      </thead>
      <tbody>
        {romanRows.map(row => (
          <tr>
            {row.map(cell => cell.n > 0 ? (
              <>
                <td class="num-cell" style="--table-color:var(--color-roman)">{cell.n}</td>
