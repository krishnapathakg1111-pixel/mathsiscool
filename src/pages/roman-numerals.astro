  <!-- 100 to 1000 -->
  <h2 style="font-family:'Nunito',sans-serif;font-size:1.2rem;font-weight:900;margin:32px 0 16px;">
    📊 Key Values: 100 to 1000
  </h2>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(110px,1fr));gap:10px;margin-bottom:40px;">
