---
import Layout from '../layouts/Layout.astro';

function toRoman(n: number): string {
  const vals = [1000,900,500,400,100,90,50,40,10,9,5,4,1];
  const syms = ['M','CM','D','CD','C','XC','L','XL','X','IX','V','IV','I'];
  let result = '';
  for(let i=0;i<vals.length;i++){
    while(n>=vals[i]){result+=syms[i];n-=vals[i];}
  }
  return result;
}

const special = [1,4,5,9,10,40,50,90,100,400,500,900,1000];

// Pre-generate all roman numeral pairs for the table (avoids nested map issues)
const romanRows: {n: number; r: string}[][] = [];
for(let row = 0; row < 20; row++) {
  const rowData: {n: number; r: string}[] = [];
  for(const offset of [0,20,40,60,80]) {
    const n = offset + row + 1;
    if(n <= 100) rowData.push({n, r: toRoman(n)});
    else rowData.push({n: 0, r: ''});
  }
  romanRows.push(rowData);
}

// 100-1000 milestones
const milestones = [100,150,200,250,300,350,400,450,500,550,600,650,700,750,800,850,900,950,1000];
const milestoneData = milestones.map(n => ({n, r: toRoman(n)}));
---

<Layout
  title="Roman Numbers 1 to 1000 — Roman Numeral Chart IV, IX, XL, CM | MathsIsCool"
  description="Roman numbers 1 to 1000 chart. What number is IV, IX, XL in Roman numerals? Roman numbers 1 to 100 with names, plus conversion rules and FAQ."
  currentPage="roman"
>
<div class="page">

  <div class="page-hero">
